@@ -374,15 +387,81 @@ X_RESULT MnkInputDriver::GetDeviceKeystroke(DeviceId id, uint32_t flags,
   if (!IsEnabled() || id != kMnkDevice) {
     return X_ERROR_DEVICE_NOT_CONNECTED;
   }
+  {
+    std::lock_guard lock(state_mutex_);
+    if (!keystroke_queue_.empty()) {
+      if (out_keystroke) {
+        *out_keystroke = keystroke_queue_.front();
+      }
+      keystroke_queue_.pop();
+      return X_ERROR_SUCCESS;
+    }
+  }
+
+  // Ordre des bits = champ buttons XInput, puis gâchettes (comme le pilote SDL).
+  static constexpr VirtualKey kVk[18] = {
+      VirtualKey::kXInputPadDpadUp,      VirtualKey::kXInputPadDpadDown,
+      VirtualKey::kXInputPadDpadLeft,    VirtualKey::kXInputPadDpadRight,
+      VirtualKey::kXInputPadStart,       VirtualKey::kXInputPadBack,
+      VirtualKey::kXInputPadLThumbPress, VirtualKey::kXInputPadRThumbPress,
+      VirtualKey::kXInputPadLShoulder,   VirtualKey::kXInputPadRShoulder,
+      VirtualKey::kNone,                 VirtualKey::kNone,
+      VirtualKey::kXInputPadA,           VirtualKey::kXInputPadB,
+      VirtualKey::kXInputPadX,           VirtualKey::kXInputPadY,
+      VirtualKey::kXInputPadLTrigger,    VirtualKey::kXInputPadRTrigger,
+  };
+  constexpr auto kRepeatDelay = std::chrono::milliseconds(400);
+  constexpr auto kRepeatRate = std::chrono::milliseconds(100);
+
+  X_INPUT_STATE state = {};
+  GetDeviceState(id, &state);  // vide si la fenêtre n'a pas le focus
+  uint32_t curr = static_cast<uint16_t>(state.gamepad.buttons);
+  curr |= uint32_t(state.gamepad.left_trigger > 30) << 16;
+  curr |= uint32_t(state.gamepad.right_trigger > 30) << 17;
+
+  auto emit = [&](int idx, uint16_t ks_flags) {
+    if (out_keystroke) {
+      *out_keystroke = {};
+      out_keystroke->virtual_key = static_cast<uint16_t>(kVk[idx]);
+      out_keystroke->flags = ks_flags;
+    }
+    return X_ERROR_SUCCESS;
+  };
+
   std::lock_guard lock(state_mutex_);
-  if (keystroke_queue_.empty()) {
+  auto now = std::chrono::steady_clock::now();
+  uint32_t changed = curr ^ keystroke_last_buttons_;
+  if (!changed && keystroke_repeat_idx_ >= 0) {
+    auto wait = keystroke_repeating_ ? kRepeatRate : kRepeatDelay;
+    if (now - keystroke_repeat_time_ >= wait) {
+      keystroke_repeating_ = true;
+      keystroke_repeat_time_ = now;
+      return emit(keystroke_repeat_idx_, X_INPUT_KEYSTROKE_KEYDOWN | X_INPUT_KEYSTROKE_REPEAT);
+    }
     return X_ERROR_EMPTY;
   }
-  if (out_keystroke) {
-    *out_keystroke = keystroke_queue_.front();
+  // Relâchements d'abord, puis appuis.
+  for (int pass = 0; pass < 2; pass++) {
+    for (int i = 0; i < 18; i++) {
+      uint32_t bit = 1u << i;
+      if (!(changed & bit) || kVk[i] == VirtualKey::kNone) continue;
+      bool pressed = curr & bit;
+      if (pass == 0 && !pressed) {
+        keystroke_last_buttons_ &= ~bit;
+        if (keystroke_repeat_idx_ == i) keystroke_repeat_idx_ = -1;
+        return emit(i, X_INPUT_KEYSTROKE_KEYUP);
+      }
+      if (pass == 1 && pressed) {
+        keystroke_last_buttons_ |= bit;
+        keystroke_repeat_idx_ = i;
+        keystroke_repeating_ = false;
+        keystroke_repeat_time_ = now;
+        return emit(i, X_INPUT_KEYSTROKE_KEYDOWN);
+      }
+    }
   }
-  keystroke_queue_.pop();
-  return X_ERROR_SUCCESS;
+  keystroke_last_buttons_ = curr;
+  return X_ERROR_EMPTY;
 }
 
