@@ -274,6 +274,19 @@ X_RESULT MnkInputDriver::GetDeviceState(DeviceId id, X_INPUT_STATE* out_state) {
 
   std::lock_guard lock(state_mutex_);
 
+  // Les touches mémorisées comptent comme enfoncées pour cette interrogation.
+  bool saved_down[256];
+  std::memcpy(saved_down, key_down_, sizeof(key_down_));
+  for (int k = 0; k < 256; k++) {
