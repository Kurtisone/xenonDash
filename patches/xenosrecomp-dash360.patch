@@ -1187,6 +1190,36 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
         }
     }
 
+    // Dash 360 : tables de constantes absentes/incomplètes -> déclare les registres et échantillonneurs non nommés
+    {
+        std::set<uint32_t> definedRegs;
+        if (shaderContainer->definitionTableOffset != NULL)
+        {
+            auto definitionTable = reinterpret_cast<const DefinitionTable*>(shaderData + shaderContainer->definitionTableOffset);
+            auto definitions = definitionTable->definitions;
+            while (*definitions != 0)
+            {
+                auto definition = reinterpret_cast<const Float4Definition*>(definitions);
+                for (uint16_t i = 0; i < (definition->count + 3) / 4; i++)
+                    definedRegs.insert(definition->registerIndex + i - (isPixelShader ? 256 : 0));
+                definitions += 2;
+            }
+        }
+        for (uint32_t r = 0; r < 256; r++)
+        {
+            if (float4Constants.find(r) == float4Constants.end() && definedRegs.find(r) == definedRegs.end())
+                println("#define c{} vk::RawBufferLoad<float4>(g_PushConstants.{}ShaderConstants + {}, 0x10)", r, isPixelShader ? "Pixel" : "Vertex", r * 16);
+        }
+        for (uint32_t r = 0; r < 16; r++)
+        {
+            if (samplers.find(r) != samplers.end())
+                continue;
+            for (size_t j = 0; j < std::size(TEXTURE_DIMENSIONS); j++)
+                println("#define s{}_Texture{}DescriptorIndex vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + {})", r, TEXTURE_DIMENSIONS[j], j * 64 + r * 4);
+            println("#define s{}_SamplerDescriptorIndex vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + {})", r, std::size(TEXTURE_DIMENSIONS) * 64 + r * 4);
+        }
+    }
+
     out += "\n#else\n\n";
 
     println("cbuffer {}ShaderConstants : register(b{}, space4)", isPixelShader ? "Pixel" : "Vertex", isPixelShader ? 1 : 0);
