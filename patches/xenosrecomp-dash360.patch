+#include <set>
 #include "shader_recompiler.h"
 #include "shader_common.h"
 
@@ -1103,14 +1104,16 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
     const auto shaderContainer = reinterpret_cast<const ShaderContainer*>(shaderData);
 
     assert((shaderContainer->flags & 0xFFFFFF00) == 0x102A1100);
-    assert(shaderContainer->constantTableOffset != NULL);
 
     out += include;
     out += '\n';
 
     isPixelShader = (shaderContainer->flags & 0x1) == 0;
 
-    const auto constantTableContainer = reinterpret_cast<const ConstantTableContainer*>(shaderData + shaderContainer->constantTableOffset);
+    // Dash 360 : les shaders sans constante n'ont pas de table (constantTableOffset == 0) -> table vide
+    static const uint8_t s_emptyConstantTable[sizeof(ConstantTableContainer)] = {};
+    const auto constantTableContainer = reinterpret_cast<const ConstantTableContainer*>(
+        shaderContainer->constantTableOffset != 0 ? shaderData + shaderContainer->constantTableOffset : s_emptyConstantTable);
     constantTableData = reinterpret_cast<const uint8_t*>(&constantTableContainer->constantTable);
 
