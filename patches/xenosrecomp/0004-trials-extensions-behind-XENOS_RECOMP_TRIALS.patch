@@ -617,7 +620,7 @@ void ShaderRecompiler::recompile(const AluInstruction& instr)
 
     std::string_view exportRegister;
     // Memory export: the address (eA) and up to five elements (eM0 to eM4), stored by memExport.
-    const bool memoryExport = instr.exportData && instr.vectorDest >= uint32_t(ExportRegister::ExportAddress) &&
+    const bool memoryExport = trialsExt && instr.exportData && instr.vectorDest >= uint32_t(ExportRegister::ExportAddress) &&
         instr.vectorDest <= uint32_t(ExportRegister::ExportData4);
     if (memoryExport)
     {
@@ -811,8 +814,11 @@ void ShaderRecompiler::recompile(const AluInstruction& instr)
             break;
 
         case AluVectorOpcode::Cube:
-            // The hardware takes the direction v as v.zzxy and v.yxzz: v is the second operand's yxz.
-            print("cube(({}).yxzz, cubeMapData)", op(VECTOR_1));
+            if (trialsExt)
+                // The hardware takes the direction v as v.zzxy and v.yxzz: v is the second operand's yxz.
+                print("cube(({}).yxzz, cubeMapData)", op(VECTOR_1));
+            else
+                print("cube(r{}, cubeMapData)", instr.src1Register);
             break;
 
         case AluVectorOpcode::Max4:
@@ -997,7 +1003,10 @@ void ShaderRecompiler::recompile(const AluInstruction& instr)
             break;
 
         case AluScalarOpcode::SetpInv:
-            print("p0 ? 0.0 : ({0} == 0.0 ? 1.0 : {0})", op(SCALAR_0));
+            if (trialsExt)
+                print("p0 ? 0.0 : ({0} == 0.0 ? 1.0 : {0})", op(SCALAR_0));
+            else
+                print("{0} == 0.0 ? 1.0 : {0}", op(SCALAR_0));
             break;
 
         case AluScalarOpcode::SetpPop:
@@ -1158,6 +1167,12 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
 
     assert((shaderContainer->flags & 0xFFFFFF00) == 0x102A1100);
 
+    // Extensions de Trials ReVolution (export mémoire, LOD, pixels invités, ...) : seulement avec
+    // XENOS_RECOMP_TRIALS=1, car elles lisent des constantes partagées que les autres projets ne fournissent pas.
+    trialsExt = getenv("XENOS_RECOMP_TRIALS") != nullptr;
+    if (trialsExt)
+        out += "#define XENOS_TRIALS_EXT\n";
+
     out += include;
     out += '\n';
 
@@ -1423,7 +1438,8 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
             vertexElements.emplace(uint32_t(vertexElement.address), vertexElement);
         }
 
-        out += "\tin uint iVertexId : SV_VertexID,\n";
+        if (trialsExt)
+            out += "\tin uint iVertexId : SV_VertexID,\n";
     #ifdef UNLEASHED_RECOMP
         if (hasIndexCount)
         {
@@ -1506,7 +1522,7 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
     bool printedRegisters[32]{};
 
     // Loop counts of the pixel shader constants the raw path keeps per draw.
-    if (isPixelShader)
+    if (trialsExt && isPixelShader)
     {
         out += "#ifdef __spirv__\n";
         out += "\tint4 i16 = int4(vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + 276) & 0xFF, 0, 0, 0);\n";
