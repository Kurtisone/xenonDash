             {
-                // Guest pixels: draws to scaled surfaces are made at several host pixels to the pixel.
-                out += "float4(floor(iPos.xy * g_PosScale) * float2(iFace ? 1.0 : -1.0, 1.0), 0.0, 0.0);\n";
+                if (trialsExt)
