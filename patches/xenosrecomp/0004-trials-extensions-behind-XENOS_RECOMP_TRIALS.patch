     }
 
-    if (instr.opcode == FetchOpcode::GetTextureComputedLod)
+    if (trialsExt && instr.opcode == FetchOpcode::GetTextureComputedLod)
     {
         // The level the hardware would pick, in the destination components that select x: Fusion hands it to setTexLOD.
         for (size_t i = 0; i < 4; i++)
@@ -314,7 +314,10 @@ void ShaderRecompiler::recompile(const TextureFetchInstruction& instr, bool bicu
     #endif
 
         // Components the fetch constant marks as unsigned biased (2 * v - 1) are converted first.
-        print("texBias(g_TexBiasBits({}), tfetch", instr.constIndex & 15);
+        if (trialsExt)
+            print("texBias(g_TexBiasBits({}), tfetch", instr.constIndex & 15);
+        else
+            out += "tfetch";
         break;
     }
     case FetchOpcode::GetTextureWeights:
@@ -349,8 +352,8 @@ void ShaderRecompiler::recompile(const TextureFetchInstruction& instr, bool bicu
 
     out += dimension;
 
