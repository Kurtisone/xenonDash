Subject: [PATCH 4/4] =?UTF-8?q?XenosRecomp=20unifi=C3=A9=20:=20extensions?=
 =?UTF-8?q?=20de=20Trials=20derri=C3=A8re=20XENOS=5FRECOMP=5FTRIALS=3D1?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Les extensions de Trials (export mémoire, LOD, biais/échelle d'exposant, pixels invités, transformation fenêtre,
compteurs de boucle, identifiant de sommet) lisent des constantes partagées (décalages 276..412) que les autres
projets ne fournissent pas : elles ne sont actives que si XENOS_RECOMP_TRIALS est défini. Dans ce cas la sortie
HLSL commence par `#define XENOS_TRIALS_EXT`, et les fonctions/constantes correspondantes de shader_common.h
sont compilées. Sans la variable, la sortie ne contient aucune de ces extensions (Dashboard 360, Skate).
Les clés de cache doivent inclure la version de XenosRecomp et ces variables (docs/fusion_ports.md §4.4).
---
 XenosRecomp/shader_common.h       | 10 +++++
 XenosRecomp/shader_recompiler.cpp | 70 +++++++++++++++++++++----------
 XenosRecomp/shader_recompiler.h   |  1 +
 3 files changed, 59 insertions(+), 22 deletions(-)

diff --git a/XenosRecomp/shader_common.h b/XenosRecomp/shader_common.h
index 6c3a6c9..430aa10 100644
--- a/XenosRecomp/shader_common.h
+++ b/XenosRecomp/shader_common.h
@@ -32,6 +32,7 @@ struct PushConstants
 #define g_SwappedTexcoords         vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + 260)
 #define g_HalfPixelOffset          vk::RawBufferLoad<float2>(g_PushConstants.SharedConstants + 264)
 #define g_AlphaThreshold           vk::RawBufferLoad<float>(g_PushConstants.SharedConstants + 272)
+#ifdef XENOS_TRIALS_EXT
 #define g_PosScale                 vk::RawBufferLoad<float2>(g_PushConstants.SharedConstants + 288)
 #define g_ScreenMul                vk::RawBufferLoad<float3>(g_PushConstants.SharedConstants + 360)
 #define g_ScreenAdd                vk::RawBufferLoad<float3>(g_PushConstants.SharedConstants + 372)
@@ -41,6 +42,7 @@ struct PushConstants
 #define g_ExportMemory             vk::RawBufferLoad<uint64_t>(g_PushConstants.SharedConstants + 384)
 #define g_ExportRegions            (g_PushConstants.SharedConstants + 400)
 #define EXPORT_REGION_COUNT        8
+#endif
 
 [[vk::constant_id(0)]] const uint g_SpecConstants = 0;
 
@@ -54,8 +56,10 @@ struct PushConstants
     float2 g_HalfPixelOffset : packoffset(c16.z); \
     float g_AlphaThreshold : packoffset(c17.x);
 
+#ifdef XENOS_TRIALS_EXT
 #define g_ScreenMul float3(1.0, 1.0, 1.0)
 #define g_ScreenAdd float3(0.0, 0.0, 0.0)
+#endif
 
 uint g_SpecConstants();
 
@@ -79,6 +83,7 @@ float4 tfetch2D(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float
     return texture.Sample(g_SamplerDescriptorHeap[samplerDescriptorIndex], texCoord + offset / getTexture2DDimensions(texture));
 }
 
+#ifdef XENOS_TRIALS_EXT
 #ifdef __spirv__
 
 // Memory export, as the SDK's translator does it: eA holds the stream (base address, index, format, count) in the
@@ -223,8 +228,10 @@ void memExport(float4 eA, float4 eM0, float4 eM1, float4 eM2, float4 eM3, float4
     }
 }
 
+#endif
 #endif
 
+#ifdef XENOS_TRIALS_EXT
 // A level the shader picked (setTexLOD), and texel rather than normalized coordinates.
 float4 tfetch2DLod(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float2 texCoord, float2 offset, float lod, bool denormalized)
 {
@@ -252,6 +259,7 @@ float4 tfetch2DDenorm(uint resourceDescriptorIndex, uint samplerDescriptorIndex,
     return texture.Sample(g_SamplerDescriptorHeap[samplerDescriptorIndex], (texCoord + offset) / getTexture2DDimensions(texture));
 }
 
+#endif
 float2 getWeights2D(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float2 texCoord, float2 offset)
 {
     Texture2D<float4> texture = g_Texture2DDescriptorHeap[resourceDescriptorIndex];
@@ -346,11 +354,13 @@ float4 tfetchCube(uint resourceDescriptorIndex, uint samplerDescriptorIndex, flo
     return g_TextureCubeDescriptorHeap[resourceDescriptorIndex].Sample(g_SamplerDescriptorHeap[samplerDescriptorIndex], cubeMapData.cubeMapDirections[texCoord.z]);
 }
 
+#ifdef XENOS_TRIALS_EXT
 float4 texBias(uint bits, float4 value)
 {
     return select(bool4(bits & 1, bits & 2, bits & 4, bits & 8), value * 2.0 - 1.0, value);
 }
 
+#endif
 float4 tfetchR11G11B10(uint4 value)
 {
     if (g_SpecConstants() & SPEC_CONSTANT_R11G11B10_NORMAL)
