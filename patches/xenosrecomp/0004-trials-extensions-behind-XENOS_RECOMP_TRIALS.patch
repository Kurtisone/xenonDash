-    const bool denormalized = instr.opcode == FetchOpcode::TextureFetch && instr.dimension == TextureDimension::Texture2D && instr.texCoordDenorm;
+    const bool explicitLod = trialsExt && instr.opcode == FetchOpcode::TextureFetch && instr.dimension == TextureDimension::Texture2D && instr.useRegLod;
+    const bool denormalized = trialsExt && instr.opcode == FetchOpcode::TextureFetch && instr.dimension == TextureDimension::Texture2D && instr.texCoordDenorm;
     if (explicitLod)
         out += "Lod";
     else if (denormalized)
@@ -376,12 +379,12 @@ void ShaderRecompiler::recompile(const TextureFetchInstruction& instr, bool bicu
         break;
     }
 
-    out += instr.opcode == FetchOpcode::TextureFetch ? "))." : ").";
+    out += (trialsExt && instr.opcode == FetchOpcode::TextureFetch) ? "))." : ").";
 
     printDstSwizzle(instr.dstSwizzle, true);
 
     // The fetch constant's exponent adjust (and the scale of integer formats), set per draw.
-    if (instr.opcode == FetchOpcode::TextureFetch)
+    if (trialsExt && instr.opcode == FetchOpcode::TextureFetch)
         print(" * g_TexExpScale({})", instr.constIndex & 15);
 
